#!/usr/bin/env python3
# Stand-in for gamemoderun: starts the game as this process's child (so /proc/<pid>/mem is
# readable under ptrace_scope 1) and serves memory reads/writes on a unix socket.
import os, sys, socket, subprocess, threading, json, base64
RT = os.environ['PEEK_DIR']
child = subprocess.Popen(sys.argv[1:])
open(os.path.join(RT, 'pid'), 'w').write(str(child.pid))
sock_path = '\0wipeout-peek'
try: pass
except FileNotFoundError: pass
srv = socket.socket(socket.AF_UNIX); srv.bind(sock_path); srv.listen(4)
def serve(conn):
    with conn, conn.makefile('rw') as f:
        for line in f:
            try:
                r = json.loads(line)
                with open(f'/proc/{child.pid}/mem', 'r+b', buffering=0) as m:
                    m.seek(r['addr'])
                    if r['op'] == 'read':
                        out = {'data': base64.b64encode(m.read(r['len'])).decode()}
                    else:
                        m.write(base64.b64decode(r['data'])); out = {'ok': True}
            except Exception as e:
                out = {'error': repr(e)}
            f.write(json.dumps(out) + '\n'); f.flush()
def accept():
    while True:
        c, _ = srv.accept(); threading.Thread(target=serve, args=(c,), daemon=True).start()
threading.Thread(target=accept, daemon=True).start()
sys.exit(child.wait())
