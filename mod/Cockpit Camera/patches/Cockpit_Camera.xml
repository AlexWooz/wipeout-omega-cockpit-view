<!-- WipEout Cockpit Camera: the PlayStation VR cockpit view in the flatscreen game.
     Found on the US eboot.bin (CUSA07671 01.07); each site is found by its signature (Pattern/At),
     Address is that build's address (game address + 0x400000). See docs/FINDINGS.md.

     The VR ships (VR HD, VR Fury, VR 2048, Zone/Detonator VR) carry a VR_Cam node and a cockpit in
     their model. The ship loader finds them outside VR too (ship+0x77d0, ship+0x77d8), and the
     internal camera (0x322fd0) already puts the eye on VR_Cam when it is there. What VR mode adds is
     that the ship model stays visible in the internal camera and the cockpit sounds start. Those
     places test the race's VR flag (0x1012810); here they test "the ship has a VR_Cam node" instead,
     so ships without a cockpit behave as before.

     Use with the built-in patch "Cheat - VR ships outside VR" to pick a VR ship. -->
<Patch>
    <TitleID>
        <ID>CUSA07671</ID>
        <ID>CUSA05670</ID>
    </TitleID>
    <Metadata Title="WipEout Omega Collection" Name="Cockpit Camera - Show cockpit" Note="In the internal camera, VR ships keep their model visible, so you sit in the cockpit. Ships without a cockpit are unchanged. Needs 'Cheat - VR ships outside VR' to pick a VR ship." Author="Alex" PatchVer="0.1" AppVer="01.00" AppElf="eboot.bin" isEnabled="true">
        <PatchList>
            <!-- Model setup (0x31e076): internal camera hides the ship unless (VR and VR_Cam).
                 Drop the VR test: je 0x31e0ed -> 2-byte nop. -->
            <Line Type="bytes" Address="0x0071e086" Value="6690" Pattern="80 bb 83 69 00 00 00 74 13 80 3d ?? ?? ?? ?? 00 74 65 48 83 bb d0 77 00 00 00 74 5b 80 bb 84 69 00 00 00 75 52 80 48 60 04" At="16"/>
            <!-- Model setup, second path (0x31e45a): internal camera hides the ship unless VR.
                 mov cl,[VR]; test cl,cl -> cmp qword [rbx+0x77d0],0 (the je after it is kept). -->
            <Line Type="bytes" Address="0x0071e463" Value="4883bbd077000000" Pattern="80 bb 83 69 00 00 00 74 0a 8a 0d ?? ?? ?? ?? 84 c9 74 04 80 48 60 04" At="9"/>
            <!-- Camera change (0x301bb4): internal camera hides the ship unless VR.
                 mov bl,[VR]; test bl,bl -> cmp qword [rcx+0x77d0],0 (rbx is not read afterwards). -->
            <Line Type="bytes" Address="0x00701bc7" Value="4883b9d077000000" Pattern="48 8b 81 b8 77 00 00 8a 91 83 69 00 00 74 0e 84 d2 74 0a 8a 1d ?? ?? ?? ?? 84 db 74 0d 84 d2 74 1f 80 b9 84 69 00 00 00 74 16 48 8b 89 80 77 00 00" At="19"/>
        </PatchList>
    </Metadata>
    <Metadata Title="WipEout Omega Collection" Name="Cockpit Camera - Cockpit sounds" Note="Starts the VR cockpit sounds (engines, servos, consoles, structure) on ships with a cockpit." Author="Alex" PatchVer="0.2" AppVer="01.00" AppElf="eboot.bin" isEnabled="true">
        <PatchList>
            <!-- Cockpit sound emitters (0x32f8f0, after the model is loaded): VR only.
                 mov al,[VR]; test al,al -> cmp qword [rbx+0x77d0],0 (the je rel32 after it is kept). -->
            <Line Type="bytes" Address="0x0072f901" Value="4883bbd077000000" Pattern="48 89 fb 85 f6 0f 85 ?? ?? ?? ?? 8a 05 ?? ?? ?? ?? 84 c0 0f 84 ?? ?? ?? ?? 48 8b 3d ?? ?? ?? ?? 48 8d 35 ?? ?? ?? ?? 31 d2 31 c9" At="11"/>
            <!-- Cockpit sound loops (0x32fc90): VR only. Same change, ship in rdi. -->
            <Line Type="bytes" Address="0x0072fc99" Value="4883bfd077000000" Pattern="53 85 f6 0f 85 ?? ?? ?? ?? 8a 05 ?? ?? ?? ?? 84 c0 0f 84 ?? ?? ?? ?? 0f b7 87 a0 8b 00 00 48 8d 0d ?? ?? ?? ?? 48 8d 15 ?? ?? ?? ?? 4c 8d 15 ?? ?? ?? ??" At="9"/>
            <!-- Ship update (0x304dac), player ship: in VR it calls 0x324160, which moves the cockpit parts
                 the emitters above are attached to, and sets the audio listener [0x11aaa78] to ship+0x6200.
                 Without it the emitters never get a position and the loops are silent.
                 cmp byte [VR],0 -> cmp [r14+0x77d0],rcx (rcx is 0 on both paths here; the je after it is kept). -->
            <Line Type="bytes" Address="0x00704dac" Value="49398ed0770000" Pattern="88 98 aa 00 00 00 85 c9 74 33 31 c9 be 00 00 00 00 48 85 d2 74 0a 48 0f be 72 5c 48 85 f6 78 0d 48 8b 15 ?? ?? ?? ?? 48 0f a3 f2 73 05 b9 c3 f5 a8 3e 89 88 ac 00 00 00 e9 ?? ?? ?? ?? 80 3d ?? ?? ?? ?? 00 74 11 4c 89 f7 e8 ?? ?? ?? ?? 49 8d 9e 00 62 00 00 eb 6d" At="61"/>
        </PatchList>
    </Metadata>
    <Metadata Title="WipEout Omega Collection" Name="Cockpit Camera - HUD on the cockpit screens" Note="The VR HUD on the cockpit screens in the cockpit view of VR ships. The other cameras, and team ships, keep the stock HUD." Author="Alex" PatchVer="0.7" AppVer="01.00" AppElf="eboot.bin" isEnabled="true">
        <PatchList>
            <!-- HUD setup (0x284a40): in VR it loads the *_VR.xml layout, the vr_hud model (0xa735c8) and
                 puts the HUD in the VR slots 0xa73690. Each frame 0x27a130 sets the render-to-texture flag
                 [frame+0x33611] for HUDs in those slots; the pass at 0x66660e draws them into 0x103f420,
                 whose texture 0x103f3e8 the ship loader (0x31dbbd) binds to the cockpit's hud_render_target.
                 je rel32 past the VR setup -> 6-byte nop, so it always runs. -->
            <Line Type="bytes" Address="0x00684c52" Value="660f1f440000" Pattern="c5 fc 11 83 d0 0a 00 00 c5 fc 11 83 b0 0a 00 00 c5 fc 11 83 90 0a 00 00 c5 fc 11 83 70 0a 00 00 e8 ?? ?? ?? ?? 80 3d ?? ?? ?? ?? 00 0f 84 ?? ?? ?? ?? 48 8d bd d0 fe ff ff e8 ?? ?? ?? ?? 48 8d 84 05 cc fe ff ff" At="44"/>
            <!-- HUD setup, the second HUD it makes for the external cameras (r15b set, slot 0xa73698): keep the
                 stock layout instead of *_VR_Ext.xml, and preset [hud+0xd88] = 2 so the line below turns its
                 view to 0 (the screen). movabs rcx,"_vr_ext." ... -> mov byte [rbx+0xd88],2; jmp 0x284f80. -->
            <Line Type="bytes" Address="0x00684c71" Value="c683880d000002e903030000" Pattern="48 8d bd d0 fe ff ff e8 ?? ?? ?? ?? 48 8d 84 05 cc fe ff ff 45 84 ff 74 19 48 b9 5f 76 72 5f 65 78 74 2e 48 89 08 c7 40 08 78 6d 6c 00 e9 ?? ?? ?? ?? 48 b9 5f 76 72 2e 78 6d 6c 00 44 89 bd ac fe ff ff 48 89 08" At="25"/>
            <!-- HUD setup: the HUD's view [hud+0xd88] = VR * 2. Every HUD element copies it to [elem+0xf8] and
                 is drawn in view list [0x104aad0 + view*8]: 0 the screen, 1 the HUD texture, 2 a screen
                 layer drawn only in VR. The HUD object is zeroed when allocated, so xor 2 gives the cockpit
                 HUD 2 and the external one (preset 2) 0.
                 mov al,[VR]; add al,al; mov [rbx+0xd88],al -> xor byte [rbx+0xd88],2 + 7-byte nop. -->
            <Line Type="bytes" Address="0x00685d82" Value="80b3880d0000020f1f8000000000" Pattern="c5 fc 57 c0 c5 fc 11 83 24 09 00 00 8a 05 ?? ?? ?? ?? 00 c0 88 83 88 0d 00 00 48 8b 0d ?? ?? ?? ?? 8a 05 ?? ?? ?? ?? 84 c0 0f 85 ?? ?? ?? ?? c5 fc 10 25 ?? ?? ?? ?? c5 7a 6f 05 ?? ?? ?? ??" At="12"/>
            <!-- Display setup (0x64b470): the HUD render target 0x103f420 is 960x540 (1920x1080 in one mode)
                 only with the front end VR flag 0x1047e20, otherwise 1x1, so whatever the HUD draws into it
                 is one pixel. cmove ebx,esi and cmove eax,esi (esi = 1) -> 3-byte nops: always full size. -->
            <Line Type="bytes" Address="0x00a4b5bf" Value="0f1f00" Pattern="83 3d ?? ?? ?? ?? 06 be 01 00 00 00 44 89 45 8c 44 89 4d 80 66 44 89 55 84 0f 94 c1 8d 57 fe 83 fa 03 0f 92 c2 ff c1 83 3d ?? ?? ?? ?? 01 0f 45 ce 69 d9 c0 03 00 00 20 c2 0f 44 de 69 c1 1c 02 00 00 84 d2 89 9d 70 ff ff ff 0f 44 c6 83 ff 05 89 85 74 ff ff ff 0f 84 ?? ?? ?? ?? 0f b6 35 ?? ?? ?? ?? 41 0f b7 d8 45 0f b7 f1 45 0f b7 fa" At="57"/>
            <Line Type="bytes" Address="0x00a4b5d0" Value="0f1f00" Pattern="83 3d ?? ?? ?? ?? 06 be 01 00 00 00 44 89 45 8c 44 89 4d 80 66 44 89 55 84 0f 94 c1 8d 57 fe 83 fa 03 0f 92 c2 ff c1 83 3d ?? ?? ?? ?? 01 0f 45 ce 69 d9 c0 03 00 00 20 c2 0f 44 de 69 c1 1c 02 00 00 84 d2 89 9d 70 ff ff ff 0f 44 c6 83 ff 05 89 85 74 ff ff ff 0f 84 ?? ?? ?? ?? 0f b6 35 ?? ?? ?? ?? 41 0f b7 d8 45 0f b7 f1 45 0f b7 fa" At="74"/>
            <!-- HUD update (0x27a130): the external HUD draws the vr_hud visor model around itself. With the stock
                 layout there is nothing to frame: jne -> nop; jmp (always skip the model). -->
            <Line Type="bytes" Address="0x0067a18e" Value="90e9dc120000" Pattern="e8 ?? ?? ?? ?? 48 8b 05 ?? ?? ?? ?? c6 80 11 36 03 00 01 48 8b 05 ?? ?? ?? ?? 41 81 fe 00 00 00 4d 0f 85 ?? ?? ?? ?? 48 39 d8 0f 85 ?? ?? ?? ?? 48 8b 05 ?? ?? ?? ?? 48 85 c0 0f 84 ?? ?? ?? ?? 80 bb 69 02 00 00 00 0f 84 ?? ?? ?? ??" At="33"/>
            <!-- HUD update (0x26b030): outside VR the HUD node [hud+0x948] gets a sway offset (+0x74) from the
                 ship's movement; in VR it is 0. On the cockpit screens the sway moves the HUD inside the screens.
                 Test the HUD's view instead of the VR flag: the cockpit HUD (view 2) gets no sway, the stock HUD
                 in the external cameras keeps it.
                 mov al,[VR]; mov rbx,[rsp+0x50]; vxorps xmm2; test al,al ->
                 mov rbx,[rsp+0x50]; vxorps xmm2; test byte [r13+0xd88],2 (the jne after it is kept). -->
            <Line Type="bytes" Address="0x0066ede4" Value="488b5c2450c5e857d241f685880d000002" Pattern="c5 f8 57 c0 41 c7 85 a4 03 00 00 00 00 00 00 41 80 bf e0 05 00 00 00 c5 f0 57 c9 0f 84 ?? ?? ?? ?? 8a 05 ?? ?? ?? ?? 48 8b 5c 24 50 c5 e8 57 d2 84 c0 0f 85 ?? ?? ?? ?? 41 80 bd f4 0c 00 00 00 c5 f0 57 c9 0f 85 ?? ?? ?? ??" At="33"/>
            <!-- HUD update (0x26b030): outside VR the HUD node [hud+0x948] gets flag bit 1 of [node+0x158] when the ship
                 is in the internal camera ([ship+0x6985]); it tilts the HUD (the shield/weapon hexagon on the cockpit
                 screens). VR leaves it clear. The block is rewritten to read the HUD's view instead of the VR flag:
                 no tilt on the cockpit HUD, stock on the external one; al = the view, as the next test (node
                 [hud+0x950]) expects. 50 bytes 0x26e6b5..0x26e6e7:
                 mov rcx,[r13+0x948]; mov al,[r13+0xd88]; xor edx,edx; test al,al; jne +10;
                 cmp byte [rsi+0x6985],0; setne dl; mov bl,[rcx+0x158]; add dl,dl; and bl,0xfd; or bl,dl;
                 mov [rcx+0x158],bl; nop -->
            <Line Type="bytes" Address="0x0066e6b5" Value="498b8d48090000418a85880d000031d284c0750a80be85690000000f95c28a995801000000d280e3fd08d388995801000090" Pattern="49 8b b6 c0 78 01 00 48 85 f6 74 08 39 8e d0 87 00 00 74 03 48 89 c6 8a 05 ?? ?? ?? ?? 49 8b 8d 48 09 00 00 84 c0 74 04 31 d2 eb 0a 80 be 85 69 00 00 00 0f 95 c2 8a 99 58 01 00 00 00 d2 80 e3 fd" At="23"/>
        </PatchList>
    </Metadata>
</Patch>
